# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (omit to use SQLite locally)
DATABASE_URL=

# Event
GUESTBOOK_TITLE=White Party
# Small line above the title. Leave empty to hide it.
GUESTBOOK_EYEBROW=SIMON 30

# Schedule (ISO 8601, Stockholm time unless an offset is given).
# Both are optional: without STARTS_AT the guestbook is open from the
# start, without ENDS_AT it never closes, without both it is always live.
GUESTBOOK_STARTS_AT=2026-08-01T18:00
GUESTBOOK_ENDS_AT=2026-08-02T02:00

# Theme: static/css/themes/<GUESTBOOK_THEME>.css
# GUESTBOOK_THEME_COLOR should match the theme's --page-background.
GUESTBOOK_THEME=white-party
GUESTBOOK_THEME_COLOR=#fafaf8

# Guests join through /join/<GUESTBOOK_ACCESS_KEY>/ (the QR code link).
# Local development: a simple key is fine.
# Production: generate a long random key, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
GUESTBOOK_ACCESS_KEY=demo

# Upload limits (defaults shown)
GUESTBOOK_MAX_IMAGES_PER_POST=20
GUESTBOOK_MAX_IMAGE_BYTES=15728640
GUESTBOOK_MAX_REQUEST_BYTES=262144000

# Development only (requires DEBUG=True)
# One of: closed, pre, live, post, archived
GUESTBOOK_DEV_PHASE=
GUESTBOOK_BYPASS_SCHEDULE=False
